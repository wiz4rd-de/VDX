{
  "name": "vdx-ui",
  "private": true,
  "version": "0.1.0",
  "description": "VDX user interface (Svelte 5 + TypeScript), one bundle for every build",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "check": "svelte-check --tsconfig ./tsconfig.json --fail-on-warnings",
    "contrast": "node scripts/contrast.mjs",
    "raster-check": "node scripts/raster-check.mjs",
    "web": "node scripts/ensure-wasm.mjs && vite",
    "web:e2e": "node scripts/ensure-wasm.mjs && vite --mode e2e",
    "web:noiso": "vite --mode noiso",
    "e2e": "playwright test"
  },
  "dependencies": {
    "svelte": "5.57.2"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "@testing-library/svelte": "5.4.2",
    "@types/node": "26.6.5",
    "jsdom": "30.1.3",
    "svelte-check": "4.7.7",
    "typescript": "6.0.3",
    "vite": "8.3.4",
    "vitest": "5.0.5"
  }
}
